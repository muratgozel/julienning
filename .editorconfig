root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# gofmt uses tabs.
[*.go]
indent_style = tab
indent_size = 4

[Makefile]
indent_style = tab

[*.{ts,tsx,js,mjs,cjs,json,jsonc,yml,yaml,md}]
indent_style = space
indent_size = 2

[*.{sh,bash}]
indent_style = space
indent_size = 2

# Trailing whitespace can be meaningful in Markdown line breaks.
[*.md]
trim_trailing_whitespace = false
